# Copy to .env and adjust. Never commit .env.

# --- docker compose ----------------------------------------------------------
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=4200

# --- API (Stage 0) -------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Local dev (API on the host, Postgres from `docker compose up -d postgres`).
# Inside docker compose the API uses the "postgres" service host instead.
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet
DATABASE_SSL=false
DATABASE_MIGRATIONS_RUN=false
CORS_ORIGINS=http://localhost:4200
TRUST_PROXY=false
LOG_LEVEL=info
SWAGGER_ENABLED=true

# --- Auth -----------------------------------------------------------------------
# DEV ONLY placeholder. Generate a real one with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_ISSUER=digital-wallet-ledger
JWT_AUDIENCE=digital-wallet-ledger
REFRESH_TOKEN_TTL_DAYS=7
# 'true' in production (HTTPS). 'false' lets the cookie work over plain http locally.
COOKIE_SECURE=false
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15

# --- Demo deposits (fake money, sandbox top-ups) --------------------------------
DEMO_DEPOSITS_ENABLED=true
# Max top-up per wallet in a rolling 24h window, in minor units
# (COP has 2 minor-unit digits: 100000000 = 1,000,000.00 COP).
DEMO_DEPOSIT_DAILY_LIMIT_MINOR=100000000

# --- Transfers + idempotency -------------------------------------------------
# Max per transfer and max sent per wallet in a rolling 24h window (minor units).
MAX_TRANSFER_MINOR=500000000
DAILY_TRANSFER_LIMIT_MINOR=2000000000
# How long a stored Idempotency-Key response is replayed.
IDEMPOTENCY_KEY_TTL_HOURS=24
